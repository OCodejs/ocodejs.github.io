{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "registryVersion": "1.0.0",
  "organization": "OCodejs",
  "controlRepository": "OCodejs/ocodejs.github.io",
  "sourceOfTruth": {
    "designSystem": "MCP page at https://mcp.ocodejs.dev/",
    "sharedAssets": "ecosystem/shared/",
    "policy": "PR-only; never merge or deploy production automatically"
  },
  "syncPolicy": {
    "mode": "pull-request",
    "targetDirectory": ".ocodejs/shared/",
    "preserveProjectCode": true,
    "overwriteOnlyManagedFiles": true,
    "neverCopySecrets": true,
    "requireExplicitModuleOptIn": true
  },
