      "repository": "OCodejs/ask-chatbot",
      "defaultBranch": "main",
      "visibility": "public",
      "kind": "application",
      "description": "AI assistant application",
      "sync": {
        "enabled": true,
        "modules": [
          "design-system",
          "shared-ui",
          "navigation"
        ],
        "targetDirectory": ".ocodejs/shared/",
        "strategy": "managed-copy",
        "createPullRequest": true
      },
      "notes": "Only opted-in shared modules are eligible; app-specific source remains untouched."
