{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ocodejs-autorun-control-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "vars": {
    "ALLOWED_REPOSITORY": "OCodejs/ocodejs.github.io",
    "ALLOWED_WORKFLOW_REF": "OCodejs/ocodejs.github.io/.github/workflows/autorun-events.yml@refs/heads/main",
    "ALLOWED_ORIGINS": "https://ocodejs.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_DEDICATED_AUTORUN_STAGING_D1",
      "database_id": "REPLACE_WITH_DEDICATED_D1_ID",
      "migrations_dir": "../migrations"
    }
  ]
}
