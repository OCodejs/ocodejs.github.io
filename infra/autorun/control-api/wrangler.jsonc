{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ocodejs-autorun-control-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "vars": {
    "ALLOWED_REPOSITORY": "OCodejs/ocodejs.github.io",
    "ALLOWED_REPOSITORY_ID": "1449322239",
    "ALLOWED_WORKFLOW_REF": "OCodejs/ocodejs.github.io/.github/workflows/autorun-control-api-tests.yml@refs/heads/main",
    "ALLOWED_ORIGINS": "https://ocodejs.github.io,https://ocodejs.co,https://www.ocodejs.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ocodejs-autorun-staging",
      "database_id": "672785ae-195b-405b-97b7-cb60eb48db5f",
      "migrations_dir": "../migrations"
    }
  ]
}
