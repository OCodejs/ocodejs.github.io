# This .gitignore is appropriate for repositories deployed to GitHub Pages and using
# a Gemfile as specified at https://github.com/github/pages-gem#conventional

# Basic Jekyll gitignores (synchronize to Jekyll.gitignore)
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Additional Ruby/bundler ignore for when: bundle install
/vendor

# Specific ignore for GitHub Pages
# GitHub Pages uses its own pages-gem version; Gemfile.lock is not used.
Gemfile.lock

# Local environment files and runtime secrets (never commit real credentials)
/.env
/.env.*
!/.env.example
**/.env
**/.env.*
!**/.env.example
/.dev.vars
/.dev.vars.*
**/.dev.vars
**/.dev.vars.*
*.pem
*.key
